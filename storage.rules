rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthed() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthed()
        && (
          (
            request.auth.token.keys().hasAny(['super_admin'])
            && request.auth.token.super_admin == true
          )
          || (
            request.auth.token.keys().hasAny(['superAdmin'])
            && request.auth.token.superAdmin == true
          )
          || (
            request.auth.token.keys().hasAny(['email'])
            && request.auth.token.keys().hasAny(['email_verified'])
            && request.auth.token.email is string
            && (
              request.auth.token.email == 'hello@beauross.com'
              || request.auth.token.email == 'hello@beaurocks.app'
            )
            && request.auth.token.email_verified == true
          )
        );
    }

    function roomDocPath(roomCode) {
      return /databases/(default)/documents/artifacts/bross-app/public/data/rooms/$(roomCode);
    }


    function organizationMemberDocPath(orgId, uid) {
      return /databases/(default)/documents/organizations/$(orgId)/members/$(uid);
    }

    function mediaUploadSessionDocPath(orgId, sessionId) {
      return /databases/(default)/documents/organizations/$(orgId)/media_upload_sessions/$(sessionId);
    }

    function isOrganizationMember(orgId) {
      return isAuthed()
        && firestore.exists(organizationMemberDocPath(orgId, request.auth.uid));
    }

    function isOrgMediaUploadSessionOwner(orgId, sessionId) {
      return isAuthed()
        && firestore.exists(mediaUploadSessionDocPath(orgId, sessionId))
        && firestore.get(mediaUploadSessionDocPath(orgId, sessionId)).data.ownerUid == request.auth.uid;
    }

    function isAllowedOrgMediaIncomingUpload(orgId, sessionId, fileName) {
      return request.resource != null
        && isOrgMediaUploadSessionOwner(orgId, sessionId)
        && firestore.get(mediaUploadSessionDocPath(orgId, sessionId)).data.status == 'pending_upload'
        && firestore.get(mediaUploadSessionDocPath(orgId, sessionId)).data.safeFileName == fileName
        && request.resource.size <= firestore.get(mediaUploadSessionDocPath(orgId, sessionId)).data.maxBytes
        && request.resource.contentType != null
        && request.resource.contentType.matches('^image/.*$');
    }

    function roomUserDocPath(roomCode, uid) {
      return /databases/(default)/documents/artifacts/bross-app/public/data/room_users/$(roomCode + "_" + uid);
    }

    function isRoomHost(roomCode) {
      return isAuthed()
        && firestore.exists(roomDocPath(roomCode))
        && (
          isSuperAdmin()
          || (
            firestore.get(roomDocPath(roomCode)).data.hostUid == request.auth.uid
            || (
              firestore.get(roomDocPath(roomCode)).data.hostUids != null
              && request.auth.uid in firestore.get(roomDocPath(roomCode)).data.hostUids
            )
          )
        );
    }

    function isRoomParticipant(roomCode) {
      return isAuthed()
        && firestore.exists(roomUserDocPath(roomCode, request.auth.uid));
    }

    function isHostMediaOwner(ownerUid) {
      return isAuthed() && (ownerUid == request.auth.uid || isSuperAdmin());
    }

    function isAllowedMediaUpload() {
      return request.resource != null
        && request.resource.size <= 150 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches('^(audio|video)/.*$');
    }

    function isAllowedHostAccountMediaUpload() {
      return request.resource != null
        && request.resource.size <= 150 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches('^(audio|video|image)/.*$');
    }

    function isAllowedLogoUpload() {
      return request.resource != null
        && request.resource.size <= 12 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches('^image/.*$');
    }

    function isAllowedPhotoUpload() {
      return request.resource != null
        && request.resource.size <= 12 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches('^image/.*$');
    }


    match /org_media/{orgId}/incoming/{sessionId}/{fileName} {
      allow read: if isOrganizationMember(orgId) || isOrgMediaUploadSessionOwner(orgId, sessionId);
      allow create: if isAllowedOrgMediaIncomingUpload(orgId, sessionId, fileName);
      allow update, delete: if false;
    }

    match /org_media/{orgId}/assets/{assetId}/{fileName=**} {
      allow read: if isOrganizationMember(orgId) || isSuperAdmin();
      allow write: if false;
    }

    match /room_uploads/{roomCode}/{fileName=**} {
      allow read: if isRoomHost(roomCode);
      allow create, update: if isRoomHost(roomCode) && isAllowedMediaUpload();
      allow delete: if isRoomHost(roomCode);
    }

    match /host_media/{ownerUid}/{fileName=**} {
      allow read: if isHostMediaOwner(ownerUid);
      allow create, update: if isHostMediaOwner(ownerUid) && isAllowedHostAccountMediaUpload();
      allow delete: if isHostMediaOwner(ownerUid);
    }

    match /room_branding/{roomCode}/{fileName=**} {
      allow read: if isRoomHost(roomCode);
      allow create, update: if isRoomHost(roomCode) && isAllowedLogoUpload();
      allow delete: if isRoomHost(roomCode);
    }

    match /round_winner_prizes/{roomCode}/{fileName=**} {
      allow read: if isRoomHost(roomCode);
      allow create, update: if isRoomHost(roomCode) && isAllowedPhotoUpload();
      allow delete: if isRoomHost(roomCode);
    }

    match /room_scene_media/{roomCode}/{fileName=**} {
      allow read: if isRoomHost(roomCode);
      allow create, update: if isRoomHost(roomCode)
        && request.resource != null
        && request.resource.size <= 150 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches('^(image|video)/.*$');
      allow delete: if isRoomHost(roomCode);
    }

    match /room_photos/{roomCode}/{uploaderUid}/{fileName=**} {
      allow read: if isRoomHost(roomCode)
        || isRoomParticipant(roomCode)
        || (isAuthed() && uploaderUid == request.auth.uid);
      allow create, update: if isAuthed()
        && uploaderUid == request.auth.uid
        && firestore.exists(roomDocPath(roomCode))
        && isRoomParticipant(roomCode)
        && isAllowedPhotoUpload();
      allow delete: if isRoomHost(roomCode) || uploaderUid == request.auth.uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
